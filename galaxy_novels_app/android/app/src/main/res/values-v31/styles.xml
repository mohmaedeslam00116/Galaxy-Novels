<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/native_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/native_splash_background</item>
        <item name="android:navigationBarColor">@color/native_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/native_splash_background</item>
        <item name="android:statusBarColor">@color/native_splash_background</item>
        <item name="android:navigationBarColor">@color/native_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
